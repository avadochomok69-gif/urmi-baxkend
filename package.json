{
  "name": "urmi-creator-platform",
  "version": "1.0.0",
  "description": "Premium subscription-based creator platform",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "client": "cd frontend && npm run dev",
    "install-all": "npm install && cd frontend && npm install",
