    "seed-packages": "node backend/scripts/seedPackages.js",
    "setup": "npm run create-admin && npm run seed-packages"
  },
  "keywords": [
    "creator",
    "subscription",
    "platform"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}
